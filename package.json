{
  "name": "io-products-benefits",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "postinstall": "node scripts/prepare-firebase-config.cjs",
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "lint": "eslint .",
    "start": "react-native start",
    "test": "jest",
    "test:native:android": "cd android && ./gradlew :io-native-components:testDebugUnitTest",
    "test:all": "npm test -- --watch=false --runInBand && npm run test:native:android",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write App.tsx 'src/**/*.{ts,tsx}' 'packages/io-native-components/src/**/*.{ts,tsx}' '__tests__/**/*.{ts,tsx}'",
    "format:check": "prettier --check App.tsx 'src/**/*.{ts,tsx}' 'packages/io-native-components/src/**/*.{ts,tsx}' '__tests__/**/*.{ts,tsx}'"
  },
  "dependencies": {
    "@react-navigation/bottom-tabs": "7.21.0",
    "@react-navigation/native": "7.5.1",
    "firebase": "12.19.0",
    "io-native-components": "file:./packages/io-native-components",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "5.11.1",
    "react-native-screens": "4.30.1",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@babel/core": "7.25.2",
    "@babel/preset-env": "7.25.3",
    "@babel/runtime": "7.25.0",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native-community/cli-platform-ios": "20.2.0",
    "@react-native/babel-preset": "0.88.0",
    "@react-native/eslint-config": "0.88.0",
    "@react-native/jest-preset": "0.88.0",
    "@react-native/metro-config": "0.88.0",
    "@react-native/typescript-config": "0.88.0",
    "@testing-library/react-native": "14.1.0",
    "@types/jest": "29.5.13",
    "@types/react": "19.2.0",
    "@types/react-test-renderer": "19.1.0",
    "@typescript-eslint/eslint-plugin": "8.72.1",
    "@typescript-eslint/parser": "8.72.1",
    "eslint": "8.57.1",
    "eslint-plugin-jest": "29.17.0",
    "jest": "29.6.3",
    "prettier": "2.8.8",
    "react-test-renderer": "19.3.0",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">= 22.11.0"
  }
}
